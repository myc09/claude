{
  "name": "codepad",
  "version": "1.0.0",
  "description": "Code-Editor für Python und C – im Browser und als Handy-App, Dateien überall synchron",
  "main": "server.js",
  "scripts": {
    "build": "esbuild src/main.js --bundle --minify --format=iife --target=es2020 --outfile=public/dist/app.js",
    "start": "node server.js",
    "dev": "npm run build && node server.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/myc09/claude.git"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/myc09/claude/issues"
  },
  "homepage": "https://github.com/myc09/claude#readme",
  "dependencies": {
    "express": "^5.3.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.14",
    "codemirror": "^6.0.2",
    "esbuild": "^0.28.2"
  },
  "private": true,
  "engines": {
    "node": ">=18"
  }
}
